# Copy to your shell environment (do NOT commit real keys).
#   macOS / zsh:   export ARGMAX_API_KEY=ax_...
#   PowerShell:    $env:ARGMAX_API_KEY = "ax_..."

# Runtime key from https://app.argmaxinc.com (starts with ax_, 34 chars).
# Required by the native Pro SDK. The Windows shim accepts and ignores it.
ARGMAX_API_KEY=ax_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret token (starts with axst_). Only used once, to log in to the Swift package registry:
#   swift package-registry login https://api.argmaxinc.com/v1/sdk/login --token $ARGMAX_SECRET_TOKEN
# Never put this in app code.
ARGMAX_SECRET_TOKEN=axst_xxxxxxxxxxxxxxxxxxxxxxxx

# Windows shim only: Hugging Face token with access to pyannote/speaker-diarization-community-1
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx
